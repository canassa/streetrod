#############################################################
#
#	Street Rod: makefile for SR.EXE
#
#	MAKE MAKEFILE in this directory builds SR.EXE with C 5.1,
#	MASM 5.1, LIB 3.11 and LINK 5.01 in the environment MSC
#	SETUP sets up (PATH, INCLUDE, LIB and TMP). MAKE runs the
#	blocks in order: the runtime library, the objects, then the
#	link. SR.LNK lists the objects in link order.
#
#############################################################

MSCLIB=D:\LIB

CC=CL /c /W3 /Fc /IINCLUDE
ASM=MASM


#	the combined medium-model emulator library, as MSC SETUP builds
#	it: the default library the objects name

MLIBCE.LIB: $(MSCLIB)\MLIBCR.LIB $(MSCLIB)\LIBH.LIB $(MSCLIB)\EM.LIB $(MSCLIB)\MLIBFP.LIB
	LIB MLIBCE.LIB +$(MSCLIB)\MLIBCR.LIB+$(MSCLIB)\LIBH.LIB+$(MSCLIB)\EM.LIB+$(MSCLIB)\MLIBFP.LIB;


#	the objects, in link order. /NT names the code segment a C file
#	shares with its neighbours; assembler files name it in .CODE

MAIN.OBJ: MODS\MAIN.C INCLUDE\ARENA.H INCLUDE\CGADRV.H INCLUDE\DISK.H \
	INCLUDE\EGADRV.H INCLUDE\GAME.H INCLUDE\MAIN.H INCLUDE\MEM.H \
	INCLUDE\MEMSTR.H INCLUDE\M_0E56A.H INCLUDE\M_0E5D2.H INCLUDE\M_0E610.H \
	INCLUDE\M_0F38A.H INCLUDE\M_10B7C.H INCLUDE\M_11E9C.H INCLUDE\SCREENS.H \
	INCLUDE\SOUND.H INCLUDE\STRUCTS.H INCLUDE\SYS.H INCLUDE\TANDYDRV.H
	$(CC) /AM /Oalsi /Gs /FPi /NTS0000_TEXT MODS\MAIN.C

M_0E6C2.OBJ: MODS\M_0E6C2.ASM
	$(ASM) /Ml MODS\M_0E6C2.ASM,M_0E6C2.OBJ,M_0E6C2.LST;

