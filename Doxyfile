# Street Rod: MSC 5.1 C interfaces. Run ./sr docs from any directory.
PROJECT_NAME           = "Street Rod"
PROJECT_BRIEF          = "Game systems and DOS interfaces"
OUTPUT_DIRECTORY       = work/doxygen
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INPUT                  = README.md docs/RECONSTRUCTION.md src
FILE_PATTERNS          = *.C *.H *.c *.h *.md
EXTENSION_MAPPING      = C=C H=C
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
# Include the existing reconstruction page so the README link resolves.
# MASM has its own documentation skill and is not parsed as C.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
# Mirrors SRENV.BAT: headers remain beside their owning source files.
INCLUDE_PATH           = src/SYS src/UI src/GAME src/VIDEO src/CGA src/EGA \
                         src/TANDY src/HERC src/INPUT src/SOUND src/DATA \
                         toolchain/msc51/INCLUDE
PREDEFINED             = far= near= huge= _far= _near= _huge= \
                         __far= __near= __huge= cdecl= _cdecl= __cdecl= \
                         pascal= _pascal= __pascal= interrupt= _interrupt= \
                         __interrupt= _loadds= __loadds= _export= __export=
QUIET                  = YES
WARNINGS               = YES
# Partial documentation is allowed; invalid documentation is never allowed.
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = work/doxygen/doxygen.warn
GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
HAVE_DOT               = YES
COLLABORATION_GRAPH    = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
